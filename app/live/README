## Как импортировать “извне” и запустить хэдж (пример кода)

Ниже — минимальный запуск `HedgeEngine` “как библиотеку”, по мотивам `live/examples/hedge_example.py`.

```python
import os
import time

from live.exchanges.exchange_factory import get_exchange_class, get_realtime_class
from live.logic.hedging import HedgeEngine
from live.logic.models import (
    HedgeConfig,
    HedgeMode,
    HedgeExecutionParams,
    HedgeOffsetsPctX10000,
    HedgeVolumeRequest,
)


def run():
    key = os.environ["BINANCE_KEY"]
    secret = os.environ["BINANCE_SECRET"]

    ExchangeClass = get_exchange_class("Binance")
    RealtimeClass = get_realtime_class("Binance")

    # Важно: Position/HedgeEngine работают в one-way, поэтому hedge_mode=False
    exchange = ExchangeClass(key=key, secret=secret, hedge_mode=False, is_realtime=True)

    rt = RealtimeClass()
    rt.start()

    exchange.wait_for_connect(timeout=60)
    rt.wait_for_connect(timeout=60)

    symbol = "SOLUSDC"
    rules = exchange.get_rules()
    rule = rules[symbol]

    quote_notional = 500.0

    def on_volume(req: HedgeVolumeRequest) -> int:
        price_float = float(int(req.price_units)) * float(rule.price_step)
        base_volume_float = float(quote_notional) / float(price_float)
        base_units = int(base_volume_float / float(rule.lot_step))
        if base_units <= 0:
            raise RuntimeError(f"on_volume: bad base_units={base_units}")
        return int(base_units)

    # offsets: pct * 10000 (пример: 0.05% => 0.05 * 10000 = 500)
    trigger_pct = 0.05
    target_pct = 0.15

    cfg = HedgeConfig(
        hedge_id=str(int(time.time() * 1000)),
        symbol=symbol,
        hedge_mode=HedgeMode.BOTH,
        trigger_offset_pct_x10000=HedgeOffsetsPctX10000(
            long=int(round(trigger_pct * 10000.0)),
            short=int(round(trigger_pct * 10000.0)),
        ),
        target_offset_pct_x10000=HedgeOffsetsPctX10000(
            long=int(round(target_pct * 10000.0)),
            short=int(round(target_pct * 10000.0)),
        ),
        execution_params=HedgeExecutionParams(
            tick_ms=5,
            gtx_cooldown_ms=5,
            entrance_timeout_ms=60_000,
        ),
    )

    hedge = HedgeEngine(config=cfg, exchange=exchange, realtime=rt, on_volume=on_volume)
    hedge.start()

    try:
        last_mc = -1
        while True:
            hedge.check()
            snap = hedge.status()
            if int(snap.mutation_counter) != int(last_mc):
                last_mc = int(snap.mutation_counter)
                print(hedge.status_json().decode("utf-8"))
            time.sleep(0.05)
    finally:
        if bool(hedge.started):
            hedge.stop()
        rt.stop()
        exchange.stop()


if __name__ == "__main__":
    run()
```
